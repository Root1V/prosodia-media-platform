# =========================================================
# Configuracion de Video Translator
# Copiar como ".env" y ajustar segun el entorno
#
# Este archivo trae los valores por defecto para GPU NVIDIA (CUDA).
# Para macOS con Apple Silicon (M1/M2/M3/M4), usa en su lugar
# ".env.macos.example" como base -> no hay CUDA, faster-whisper corre en
# CPU y Ollama/Metal se encarga de acelerar el LLM automaticamente.
# =========================================================

# --- Transcripcion (faster-whisper) ---
WHISPER_MODEL_SIZE=large-v3          # tiny|base|small|medium|large-v2|large-v3
WHISPER_DEVICE=cuda                  # cuda|cpu (Mac: siempre cpu, CTranslate2 no soporta MPS)
WHISPER_COMPUTE_TYPE=float16         # float16 (cuda) | int8 / int8_float32 (cpu, recomendado en Mac)
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
# 0 = usar todos los nucleos disponibles. Ajuste de mayor impacto para
# transcripcion en CPU: CTranslate2 no siempre satura todos los nucleos
# por defecto sin esto.
WHISPER_CPU_THREADS=0
WHISPER_NUM_WORKERS=1

# --- Traduccion (LLM open source servido por Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct    # tambien: llama3.1:8b-instruct, mistral-nemo
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_SECONDS=120
TRANSLATION_BATCH_MAX_CHARS=1800
TRANSLATION_CONTEXT_WINDOW_SEGMENTS=6

# --- Sintesis de voz / doblaje (opcional, requerido solo para --mode dubbed) ---
TTS_BACKEND=index_tts2               # index_tts2 (recomendado) | coqui_xtts

# IndexTTS-2.5: recomendado, control nativo de duracion para sincronizar el doblaje
INDEX_TTS2_MODEL_DIR=third_party/index-tts/checkpoints
INDEX_TTS2_CFG_PATH=third_party/index-tts/checkpoints/config.yaml
INDEX_TTS2_USE_BF16=true
# vacio = autodetectar (cuda > mps > cpu). En macOS con TTS_PARALLEL_WORKERS
# > 1 el proyecto fuerza "cpu" automaticamente aunque dejes esto vacio: varios
# procesos usando Metal (MPS) a la vez pueden crashear el driver de GPU y
# reiniciar el sistema. Ver .env.macos.example para mas detalle.
INDEX_TTS2_DEVICE=

# Coqui XTTS v2: alternativa mas simple de instalar, requiere Python < 3.12
TTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
TTS_DEVICE=cuda

# --- Rendimiento de la sintesis de voz (doblaje), critico en videos largos ---
# 0 = auto-detectar (mitad de los nucleos disponibles, tope de 6). Cada
# worker carga su propia copia del modelo en memoria.
TTS_PARALLEL_WORKERS=0
# Fusiona segmentos consecutivos del MISMO hablante (requiere --diarize) con
# poco silencio entre ellos en una sola llamada de sintesis, en vez de una
# por cada segmento de Whisper (miles en un video largo).
TTS_GROUP_SEGMENTS=true
TTS_GROUP_MAX_GAP_SECONDS=0.5
TTS_GROUP_MAX_CHARS=200

# --- Diarizacion de hablantes (opcional, --diarize) ---
# Corre en un venv AISLADO (./scripts/setup_diarization_env.sh), invocado por
# subprocess: pyannote.audio choca de version (protobuf) con IndexTTS-2.5 si
# se instalan en el mismo entorno. Ver comentario en pyproject.toml.
DIARIZATION_PYTHON_BIN=.venv-diarization/bin/python
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_DEVICE=cuda
HF_TOKEN=                            # requerido: crear en hf.co/settings/tokens
                                      # y aceptar terminos del modelo en su pagina de HF
GENDER_DETECTION_ENABLED=true
# macOS unicamente: ruta a la carpeta "lib" de un entorno conda-forge con
# ffmpeg < 8 (fix del bug de torchcodec/Homebrew, ver README). Se aplica SOLO
# al subprocess de diarizacion, nunca rompe el ffmpeg del resto del proyecto.
# Ejemplo: /opt/homebrew/Caskroom/miniforge/base/envs/ffmpeg-libs/lib
DIARIZATION_DYLD_LIBRARY_PATH=                      # Mac: usar "cpu" (XTTS en MPS es inestable)

# --- Procesamiento de medios ---
# El ffmpeg estandar de Homebrew no trae libass: alcanza para todo salvo
# incrustar subtitulos/captions (dubbing/subtitulos en modo "burn", y el
# micro-video). Para eso, instala "ffmpeg-full" (brew install ffmpeg-full,
# keg-only) y apunta estas dos variables a su ruta, p.ej.
# /opt/homebrew/opt/ffmpeg-full/bin/ffmpeg.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
AUDIO_SAMPLE_RATE=16000

# --- General ---
OUTPUT_DIR=./output
WORKDIR=./.work
LOG_LEVEL=INFO
LOG_JSON=false

# --- Telemetria hacia Argus (ver RM-41) ---
# Solo hace falta para correr la API y el worker NATIVOS (fase 1, en el Mac).
# En docker-compose ya vienen puestas por servicio, y ahi el host es
# "host.docker.internal" en vez de "localhost" -- eso es un invento de Docker
# y no resuelve fuera de un contenedor.
#
# OTEL_SERVICE_NAME y OTEL_RESOURCE_ATTRIBUTES van POR PROCESO: la API y el
# worker son dos identidades distintas, asi que no se pueden poner aqui las
# dos. Puestas de este fichero valen para una sola; para la otra, prefijalas
# en su linea de arranque (ver el README, "Running it: two ways", opcion B).
# Si se olvidan, el servicio sale como "unknown-service" y la telemetria se
# exporta igual, sin aviso -- se ve en el log de arranque de argus.init.
#
# OJO: pydantic-settings lee este fichero para SUS ajustes, pero no lo vuelca
# a os.environ, y el SDK de OpenTelemetry lee de os.environ. Para que estas
# lleguen hay que arrancar con "uv run --env-file .env ..." (o exportarlas a
# mano en la shell). Sin OTEL_EXPORTER_OTLP_ENDPOINT no se exporta nada y el
# coste es cero.
#
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=prosodia-api      # en el worker: prosodia-worker
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=prosodia,argus.component.role=api,service.version=dev
#
# Entorno de despliegue. Vale para los dos procesos, asi que este si va aqui.
# El vocabulario es el del estandar de OpenTelemetry -- production, staging,
# test, development -- y no uno de Argus (ver A-18 en el canal). Todo lo que
# corre en el portatil es "development", incluido lo que uno llamaria "local"
# o "mac-dev": eso responde a "en que maquina corre", que es host.name y lo
# pone el agente. Sin esta variable el SDK rellena "local", que no agrupa con
# el resto del portafolio.
# ARGUS_ENVIRONMENT=development
